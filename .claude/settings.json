{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-code.mjs\"",
            "timeout": 30,
            "statusMessage": "Проверяю код на ошибки…"
          }
        ]
      }
    ]
  }
}
